# Stripe Configuration
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PRICE_ID=price_...
STRIPE_TEST_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_CONFIRM_ENABLED=true

# Email - Resend
RESEND_API_KEY=re_...
RESEND_FROM=Fasting Plan <noreply@yourdomain.com>

# Email - SMTP (alternative to Resend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email@example.com
SMTP_PASS=password
SMTP_FROM=noreply@yourdomain.com

# Database
POSTGRES_URLPG=postgres://...

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_STRIPE_CONFIRM_ENABLED=true
NEXT_PUBLIC_CO_DEV_ENV=production
NEXT_PUBLIC_DEBUG_BANNER=false

# Payment bypass — emails listed here skip Stripe and receive the full plan directly
BYPASS_PAYMENT_EMAIL=tray14@hotmail.com
